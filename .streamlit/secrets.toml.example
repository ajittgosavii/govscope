# .streamlit/secrets.toml.example
#
# Copy this file to .streamlit/secrets.toml and fill in real values.
# secrets.toml is listed in .gitignore — NEVER commit the real file.
#
# On Streamlit Community Cloud, add each key/value pair via the
# "Secrets" panel in your app settings instead of uploading this file.

[auth]
username = "your-username"
password = "your-strong-password"

[watsonx]
# IBM watsonx.ai credentials (optional — the app works without them,
# falling back to a rule-based audit brief).
api_key    = "your-ibm-cloud-api-key"
project_id = "your-watsonx-project-id"
url        = "https://ca-tor.ml.cloud.ibm.com"
model_id   = "meta-llama/llama-3-3-70b-instruct"
